#include <iostream>
#include <fstream>
#include <string>

using namespace std;

// Tamanho maximo da garagem
const int TAM = 100;

// 1) Struct
typedef struct {
    string placa;
    string dataEntrada;
} Veiculo;

// 2) Garagem e um vetor de TAM veiculos
Veiculo garagem[TAM];
int totalVeiculos = 0; // Controla a quantidade atual de carros na garagem

// Funcao auxiliar para salvar o vetor atualizado no arquivo
void salvarArquivo() {
    ofstream arquivo("garagem.txt");
    for (int i = 0; i < totalVeiculos; i = i + 1) {
        arquivo << garagem[i].placa << endl;
        arquivo << garagem[i].dataEntrada << endl;
    }
    arquivo.close();
}

// Funcao para carregar os dados do arquivo ao iniciar o programa
void conectarBase() {
    ifstream arquivo("garagem.txt");
    
    if (arquivo) {
        string placaLida, dataLida;
        
        // Le a placa e a data linha por linha
        while (getline(arquivo, placaLida) && getline(arquivo, dataLida)) {
            if (totalVeiculos < TAM) {
                garagem[totalVeiculos].placa = placaLida;
                garagem[totalVeiculos].dataEntrada = dataLida;
                totalVeiculos = totalVeiculos + 1;
            }
        }
        arquivo.close();
    }
}

// 1) Entrada de veiculo
void entradaVeiculo() {
    if (totalVeiculos >= TAM) {
        cout << "A garagem esta cheia!" << endl;
        return;
    }

    string placaInput, dataInput;

    cout << "Digite a placa do veiculo: ";
    getline(cin, placaInput);

    cout << "Digite a data/hora de entrada: ";
    getline(cin, dataInput);

    // Insere no vetor
    garagem[totalVeiculos].placa = placaInput;
    garagem[totalVeiculos].dataEntrada = dataInput;
    totalVeiculos = totalVeiculos + 1;

    // Atualiza o arquivo
    salvarArquivo();

    cout << "Veiculo cadastrado com sucesso!" << endl;
}

// 2) Listagem de veiculos
void listagemVeiculos() {
    if (totalVeiculos == 0) {
        cout << "A garagem esta vazia." << endl;
        return;
    }

    cout << "\n--- VEICULOS NA GARAGE ---" << endl;
    for (int i = 0; i < totalVeiculos; i = i + 1) {
        cout << "Placa: " << garagem[i].placa 
             << " | Data de Entrada: " << garagem[i].dataEntrada << endl;
    }
}

// 3) Saida de veiculo
void saidaVeiculo() {
    if (totalVeiculos == 0) {
        cout << "A garagem esta vazia." << endl;
        return;
    }

    string placaBusca;
    cout << "Digite a placa do veiculo para remover: ";
    getline(cin, placaBusca);

    int posicaoEncontrada = -1;

    // Procura a posicao da placa no vetor
    for (int i = 0; i < totalVeiculos; i = i + 1) {
        if (garagem[i].placa == placaBusca) {
            posicaoEncontrada = i;
            break;
        }
    }

    // Se encontrou, remove do vetor reorganizando os elementos
    if (posicaoEncontrada != -1) {
        for (int i = posicaoEncontrada; i < totalVeiculos - 1; i = i + 1) {
            garagem[i] = garagem[i + 1];
        }
        totalVeiculos = totalVeiculos - 1;

        // Sobrescreve o arquivo com a lista atualizada
        salvarArquivo();

        cout << "Veiculo removido da garagem e do arquivo com sucesso!" << endl;
    } else {
        cout << "Veiculo nao encontrado." << endl;
    }
}

int main() {
    // Conecta a base de dados (carrega o arquivo no vetor) antes de abrir o menu
    conectarBase();

    int opcao = 0;

    do {
        cout << "\n--- MENU DE OPCOES ---" << endl;
        cout << "1 - Entrada veiculo" << endl;
        cout << "2 - Listagem veiculos" << endl;
        cout << "3 - Saida veiculo" << endl;
        cout << "4 - Fim programa" << endl;
        cout << "Escolha uma opcao: ";
        
        cin >> opcao;
        cin.ignore(); // Limpa o buffer de entrada do teclado

        switch (opcao) {
            case 1:
                entradaVeiculo();
                break;
            case 2:
                listagemVeiculos();
                break;
            case 3:
                saidaVeiculo();
                break;
            case 4:
                cout << "Saindo do programa..." << endl;
                break;
            default:
                cout << "Opcao invalida. Tente novamente." << endl;
        }

    } while (opcao != 4);

    return 0;
}
