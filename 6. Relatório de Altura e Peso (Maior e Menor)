6. Relatório de Altura e Peso (Maior e Menor)
    Contexto: Uma academia está avaliando o perfil físico dos alunos.
    * Struct: Perfil (Código, Peso, Altura).
    * Menu:
   1. Cadastrar aluno.
   2. Exibir o aluno mais alto cadastrado até o momento (busca de maior valor).
   3. Sair.

#include <iostream>
#include <string>
#include <vector>

using namespace std;

const int MAX_ALUNOS = 100;

struct Perfil {
    int codigo;
    float peso;
    float altura;
};

int main() {
    Perfil academia[MAX_ALUNOS];
    int totalAlunos = 0;
    int opcao = 0;

    do {
        cout << "\n--- ACADEMIA - PERFIL FISICO ---\n";
        cout << "1. Cadastrar aluno\n";
        cout << "2. Exibir aluno mais alto\n";
        cout << "3. Sair\n";
        cout << "Escolha uma opcao: ";
        cin >> opcao;

        if (opcao == 1) {
            if (totalAlunos < MAX_ALUNOS) {
                cout << "\nDigite o codigo do aluno: ";
                cin >> academia[totalAlunos].codigo;

                cout << "Digite o peso (kg): ";
                cin >> academia[totalAlunos].peso;

                cout << "Digite a altura (m): ";
                cin >> academia[totalAlunos].altura;

                totalAlunos = totalAlunos + 1;
                cout << "Aluno cadastrado com sucesso!\n";
            } else {
                cout << "Limite de alunos atingido!\n";
            }
        } 
        else if (opcao == 2) {
            if (totalAlunos == 0) {
                cout << "\nNenhum aluno cadastrado ate o momento.\n";
            } else {
                int indiceMaisAlto = 0;

                for (int i = 1; i < totalAlunos; i = i + 1) {
                    if (academia[i].altura > academia[indiceMaisAlto].altura) {
                        indiceMaisAlto = i;
                    }
                }

                cout << "\n--- ALUNO MAIS ALTO ---\n";
                cout << "Codigo: " << academia[indiceMaisAlto].codigo 
                     << " | Peso: " << academia[indiceMaisAlto].peso << " kg"
                     << " | Altura: " << academia[indiceMaisAlto].altura << " m" << endl;
            }
        } 
        else if (opcao == 3) {
            cout << "\nEncerrando o programa...\n";
        } 
        else {
            cout << "\nOpcao invalida. Tente novamente.\n";
        }

    } while (opcao != 3);

    return 0;
}
